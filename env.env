# Copia questo file in ".env" e riempi i valori reali.
# NON committare mai il file ".env" (solo questo .example) su repository pubblici.

# Puoi configurare entrambe le fonti dati e scegliere quale usare per ogni
# singolo monitoraggio dal sito. Lascia vuota quella che non usi.

# Fonte "travelpayouts": gratuita, illimitata, ma dati in cache (2-7 giorni) —
# token da Travelpayouts, Profilo -> API token
TRAVELPAYOUTS_TOKEN=76a38787fba9218af7ef4e0f7a3e9e5d

# Bot Telegram per le notifiche
TELEGRAM_BOT_TOKEN=8456107740:AAHOEFWeRGG4tcxCmo4rdjMWINiiE1D0MIE
TELEGRAM_CHAT_ID=7455973891

# Ogni quante ore ricontrollare tutti i monitoraggi attivi
CHECK_INTERVAL_HOURS=8

# Fonte "serpapi": dati live da Google Flights, ma a consumo (piano gratuito
# limitato) — chiave da serpapi.com, sezione "Your Account"
SERPAPI_KEY=ac1794eb3aba75119cfa7086bc82c5fd489f2ab696700dbbcf57f61c6ad6e34d
MAX_DATE_SAMPLES=10

# Porta su cui gira il server (Railway/Render la impostano da soli in produzione)
PORT=3000
