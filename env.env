# Copia questo file in ".env" e riempi i valori reali.
# NON committare mai il file ".env" (solo questo .example) su repository pubblici.

# Token API ottenuto da Travelpayouts (Profilo -> API token)
TRAVELPAYOUTS_TOKEN=inserisci_qui_il_tuo_token

# Bot Telegram per le notifiche (vedi README per come crearlo)
TELEGRAM_BOT_TOKEN=inserisci_qui_il_token_del_bot
TELEGRAM_CHAT_ID=inserisci_qui_il_tuo_chat_id

# Ogni quante ore ricontrollare tutti i monitoraggi attivi
CHECK_INTERVAL_HOURS=6

# Porta su cui gira il server (Railway/Render la impostano da soli in produzione)
PORT=3000
